# Copy to .env and fill in. NEVER commit the real .env.
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
JWT_SIGNING_KEY=generate-a-32+-byte-random-string
# AES-256 key for provider credentials at rest: `openssl rand -base64 32`.
# Leave empty only on an existing deployment whose rows were encrypted with the
# legacy JWT-derived key.
DATA_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=   # optional platform-wide fallback — org admins connect their own at /admin/providers

# Self-service organization signup (POST /api/v1/auth/register + /register page).
# Keep disabled on a single-company deployment; the bootstrap admin creates users.
REGISTRATION_ENABLED=false
REGISTRATION_INVITE_CODE=

# Optional: connect Claude by browser login instead of pasting an API key. Only set
# this with an OAuth client that Anthropic issued to YOUR organization. Do not reuse
# another application's client id — that violates the provider's terms.
ANTHROPIC_OAUTH_CLIENT_ID=
ANTHROPIC_OAUTH_CLIENT_SECRET=
ANTHROPIC_OAUTH_AUTHORIZE_URL=
ANTHROPIC_OAUTH_TOKEN_URL=
ANTHROPIC_OAUTH_SCOPES=
ANTHROPIC_OAUTH_REDIRECT_URI=   # e.g. https://ai.example.com/admin/providers/callback

# WhatsApp OTP gateway. Admin (OrgAdmin/SuperAdmin) logins are second-factored
# through this bot. Set WHATSAPP_ENABLED=false when no bot is reachable —
# admins then log in with a password alone, which is recorded in the audit log.
WHATSAPP_ENABLED=true
WHATSAPP_BOT_URL=http://host.docker.internal:3000
WHATSAPP_BOT_API_KEY=   # rotate: an earlier value was committed to this file

# First-admin bootstrap. Seeds one organization, workspace, and super admin the
# first time the gateway starts against an empty database, then no-ops forever.
# A phone number is required unless WHATSAPP_ENABLED=false, since admin logins
# are OTP-gated and an account without one can never complete login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PHONE=       # E.164, e.g. 919876543210
BOOTSTRAP_ORG_NAME=YourCompany
BOOTSTRAP_ORG_SLUG=yourcompany
