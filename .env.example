# Copy to .env and fill in. NEVER commit the real .env.
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
JWT_SIGNING_KEY=generate-a-32+-byte-random-string
# AES-256 key for provider credentials at rest: `openssl rand -base64 32`.
# Leave empty only on an existing deployment whose rows were encrypted with the
# legacy JWT-derived key.
DATA_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=   # optional platform-wide fallback — org admins connect their own at /admin/providers

# Self-service organization signup (POST /api/v1/auth/register + /register page).
# Keep disabled on a single-company deployment; the bootstrap admin creates users.
REGISTRATION_ENABLED=false
REGISTRATION_INVITE_CODE=

# ── Connect a provider by browser login (OAuth) ───────────────────────────────
# Optional. Only set this with an OAuth client the provider issued to YOUR
# organization; reusing another application's client id violates their terms and
# gets the account blocked. Leave blank and admins connect with an API key instead —
# the connection model is identical either way.
#
# Register this exact redirect URI with the provider (it is matched character for
# character), then set the same value here:
#
#   https://<your-apus-domain>/api/provider-connections/anthropic/oauth/callback
#
# The browser lands back there with ?code=&state=; APUS validates the state and the
# browser-bound flow cookie, exchanges the code, encrypts the access and refresh
# tokens, stores the connection and redirects the admin to
# /settings/ai-providers?connected=anthropic.
PROVIDER_OAUTH_ANTHROPIC_CLIENT_ID=
PROVIDER_OAUTH_ANTHROPIC_CLIENT_SECRET=
PROVIDER_OAUTH_ANTHROPIC_AUTHORIZE_URL=
PROVIDER_OAUTH_ANTHROPIC_TOKEN_URL=
PROVIDER_OAUTH_ANTHROPIC_REVOKE_URL=       # optional; used on disconnect
PROVIDER_OAUTH_ANTHROPIC_SCOPES=
PROVIDER_OAUTH_ANTHROPIC_REDIRECT_URI=

# Legacy names for the same Anthropic client, still honoured. Used only when the
# PROVIDER_OAUTH_ANTHROPIC_* block above is unset.
ANTHROPIC_OAUTH_CLIENT_ID=
ANTHROPIC_OAUTH_CLIENT_SECRET=
ANTHROPIC_OAUTH_AUTHORIZE_URL=
ANTHROPIC_OAUTH_TOKEN_URL=
ANTHROPIC_OAUTH_SCOPES=
ANTHROPIC_OAUTH_REDIRECT_URI=

# ── Billing ───────────────────────────────────────────────────────────────────
# Organizations are billed in their own currency; provider list prices are USD.
# Pin the rate your finance team uses so a report does not move because an FX feed
# did. An organization can override it.
BILLING_DEFAULT_CURRENCY=USD
BILLING_USD_RATE_INR=83
# Default customer markup in basis points (2500 = +25%). 0 bills at provider cost.
BILLING_DEFAULT_MARKUP_BPS=0

# ── Rollout flags ─────────────────────────────────────────────────────────────
# Each is on, off, or on for a named list of organization ids. Leave unset for the
# defaults: connections, OAuth, allowances and usage billing on; fallback off.
FEATURE_AI_PROVIDER_FALLBACK=false

# ── Secrets at rest ───────────────────────────────────────────────────────────
# Key rotation: add the new key as version 2, point CurrentKeyVersion at it, and the
# rotation worker re-seals stored credentials in the background. Keep the old key
# until nothing reports the old version.
DATA_ENCRYPTION_KEY_V2=
DATA_ENCRYPTION_CURRENT_VERSION=

# WhatsApp OTP gateway. Admin (OrgAdmin/SuperAdmin) logins are second-factored
# through this bot. Set WHATSAPP_ENABLED=false when no bot is reachable —
# admins then log in with a password alone, which is recorded in the audit log.
WHATSAPP_ENABLED=true
WHATSAPP_BOT_URL=http://host.docker.internal:3000
WHATSAPP_BOT_API_KEY=   # rotate: an earlier value was committed to this file

# First-admin bootstrap. Seeds one organization, workspace, and super admin the
# first time the gateway starts against an empty database, then no-ops forever.
# A phone number is required unless WHATSAPP_ENABLED=false, since admin logins
# are OTP-gated and an account without one can never complete login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PHONE=       # E.164, e.g. 919876543210
BOOTSTRAP_ORG_NAME=YourCompany
BOOTSTRAP_ORG_SLUG=yourcompany
