FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY src/ ./
RUN dotnet publish Analytics.Worker/Analytics.Worker.csproj -c Release -o /app

# The worker references Gateway.Api (a web project), so it needs the ASP.NET Core
# shared framework — runtime:9.0 alone fails at launch with "framework not found".
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app
RUN adduser --disabled-password --uid 10001 appuser
COPY --from=build /app .
USER appuser
ENTRYPOINT ["dotnet", "Analytics.Worker.dll"]
